{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macrun Desktop",
  "version": "0.1.0",
  "identifier": "dev.macrun.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Macrun",
        "width": 1280,
        "height": 900,
        "minWidth": 760,
        "minHeight": 580,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 16 },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/macrun"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
